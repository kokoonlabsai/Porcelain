# Copy this file to server/.env and fill it in. server/.env is never committed.

# Database: a local mongod, or your Atlas connection string with the database name after the host.
MONGODB_URI=mongodb://127.0.0.1:27017/clinic
JWT_SECRET=change-me-to-a-long-random-string
TZ=Asia/Kolkata

# First admin login, created on start-up.
ADMIN_PHONE=9000000001
ADMIN_PASSWORD=admin123

# Razorpay: Dashboard → Account & Settings → API keys. Test keys (rzp_test_…) work for trying it out.
# Online shop payments and booking deposits only appear once these are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:5173
